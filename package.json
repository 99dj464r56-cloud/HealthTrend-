{
  "name": "healthtrend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "audit:public": "node scripts/audit-public.mjs",
    "test:release": "npm test && npm run build && npm run audit:public && npm run test:e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:share": "node scripts/build-share.ts",
    "build:mac": "node scripts/build-mac-app.ts",
    "build:pages": "node scripts/build-pages.ts",
    "audit:pages": "VITE_BASE_PATH=/HealthTrend-/ node scripts/audit-public.mjs",
    "test:release:pages": "npm test && npm run build:pages && npm run audit:pages && npm run test:e2e"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "productName": "HealthTrend",
  "author": "vimi"
}
